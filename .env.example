# BuyWise Phase 1 — environment placeholders ONLY. Copy to .env and fill locally. Never commit .env.
# Each credential's entry point is documented in README.md section "Credentials".

# --- Postgres / n8n core (required) ---
POSTGRES_DB=buywise
POSTGRES_USER=buywise
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# --- LLM layer (optional hosted reasoning; deterministic fallback is default) ---
LLM_PROVIDER=none                  # none (default) | openai-compatible | ollama (local, needs RAM)
# LLM_API_URL=https://api.example/v1   # required for openai-compatible
# LLM_API_KEY=                         # bearer key; env only, never logged/stored
# LLM_MODEL=                           # required model name
# OLLAMA_PORT=11434                    # local Ollama, if ever used

# --- Real provider keys (leave EMPTY if not configured; gateway returns UNAVAILABLE) ---
# Enter in .env (local) AND/OR n8n Credentials (see README). Never paste into prompts, workflows, or git.
# Provider strategy: SerpAPI Google Shopping (primary commercial) + Tavily (web research).
# eBay is NOT REQUIRED and inactive unless EBAY_ENABLED=true (kept only for audit history).
TAVILY_API_KEY=
SERPAPI_API_KEY=
EBAY_ENABLED=false
EBAY_APP_ID=
EBAY_CERT_ID=
YELP_API_KEY=

# --- Procurement policy ---
NEGOTIATION_SEND_MODE=DRAFT_ONLY
# DRAFT_ONLY (default: email proposals can only ever be drafts, sends impossible)
# | HUMAN_CONFIRMATION (sends allowed, still one explicit human confirm per proposal)
